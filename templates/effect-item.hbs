<div class="effect-item" data-effect-id="{{id}}" title="{{name}} ({{tag}}) - {{desc}}">
    <div class="effect-item-header">
        <span class="effect-item-title">{{name}}</span>
        <span class="effect-item-tag">{{tag}}</span>
    </div>
    <div class="effect-item-desc">{{desc}}</div>
</div>
